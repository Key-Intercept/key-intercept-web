---
const title = "Callback";
export const prerender = false;
import Layout from "../layouts/layout.astro";
---

<Layout title={title}>
    <h1>{title}</h1>
    <p>Processing authentication...</p>
</Layout>

<style>
    h1 {
        color: #eee;
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    p {
        font-size: 1.25rem;
        color: #eee;
    }
</style>

<script>
    const runCallbackFlow = async () => {
        try {
            const urlParams = new URLSearchParams(window.location.search);

            const code = urlParams.get("code");
            if (!code) {
                window.location.replace("/");
                return;
            }

            window.history.replaceState({}, document.title, window.location.pathname);

            const response = await fetch("/api/discord-login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ code }),
            });

            const data = await response.json().catch(() => ({}));

            if (!response.ok) {
                throw new Error(data.error || "Login failed");
            }

            if (data.success) {
                window.location.replace("/configs");
                return;
            }

            throw new Error("Login failed");
        } catch (error) {
            console.error("Login error:", error);
            window.location.replace("/");
        }
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", runCallbackFlow, { once: true });
    } else {
        void runCallbackFlow();
    }
</script>
