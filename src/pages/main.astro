---
export const prerender = false;

import Layout from "../layouts/mainPage.astro";
import Card from "../components/card";
import RulesPageContainer from "../components/rules-page-container";
import { createClient } from "@supabase/supabase-js";
import type { Rule } from "../script/types";

const title = "Rules";
const queryParams = Astro.url.searchParams;
if (!queryParams.has("config") || queryParams.get("config") === null) {
    return Astro.redirect("/configs");
}
const configID = BigInt(queryParams.get("config")!);

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.SUPABASE_SERVICE_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);
const { data: configData, error: configError } = await supabase
    .from('Config')
    .select('id, rules_end')
    .eq('id', configID)
    .single();

if (configError) {
    console.error('[supabase] Error fetching config:', configError);
}

const { data: rulesData, error } = await supabase
    .from('Rules')
    .select('*')
    .eq('config_id', configID);

if (error) {
    console.error('[supabase] Error fetching rules:', error);
}

const initialRules = rulesData ? rulesData.map((rule) => ({
    id: rule.id,
    created_at: new Date(rule.created_at),
    updated_at: new Date(rule.updated_at),
    config_id: rule.config_id,
    rule_regex: new RegExp(rule.rule_regex),
    rule_replacement: rule.rule_replacement,
    regex_normalize: rule.regex_normalize,
    enabled: rule.enabled,
    chance_to_apply: rule.chance_to_apply,
    label: rule.label,
    order: rule.order,
    group_id: rule.group_id,
})) : [];

const initialRulesEnd = configData?.rules_end ? new Date(configData.rules_end).toISOString() : new Date().toISOString();

const { data: groupsData, error: groupsError } = await supabase
  .from("Rules_Groups")
  .select("*")
  .eq("config_id", configID);

if (groupsError) {
  console.error("[supabase] Error fetching rule groups:", groupsError);
}

const initialGroups = groupsData ? groupsData.map((group) => ({
  id: group.id,
  config_id: group.config_id,
  disabled_at: new Date(group.disabled_at),
  created_at: new Date(group.created_at),
  name: group.name,
  rules: [],
})) : [];

---

<Layout title={title}>
  <RulesPageContainer initialRules={initialRules} initialConfigId={configID.toString()} initialRulesEnd={initialRulesEnd} initialGroups={initialGroups} client:load />
</Layout>
