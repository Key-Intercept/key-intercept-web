---
const title = "Configs";
export const prerender = false;
import Layout from "../layouts/layout.astro";
import Card from "../components/card.tsx";
import ConfigSelect from "../components/config-select.tsx";
import { verifySessionToken } from "../api/auth.js";

const searchParams = Astro.url.searchParams;
const sessionToken = searchParams.get("ki-session");

let discordID: string | null = null;

if (sessionToken) {
    try {
        // Verify session token and extract discord_id
        discordID = await verifySessionToken(`Bearer ${sessionToken}`);
    } catch (error) {
        console.error('[configs] Session verification failed:', error);
    }
}
---

<Layout title={title}>
    <Card title={title}>
        {discordID ? (
            <ConfigSelect discordID={discordID} />
        ) : (
            <p>Missing or invalid session. Please log in again.</p>
        )}
    </Card>
</Layout>

<script>
    const select = document.getElementById("config-select");
    if (select instanceof HTMLSelectElement) {
        select.addEventListener("change", () => {
            const selectedConfig = select.value;
            if (selectedConfig) {
                window.location.href = `/main?config=${selectedConfig}`;
            }
        });
    }
</script>
