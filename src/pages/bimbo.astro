---
export const prerender = false;

import { createClient } from "@supabase/supabase-js";
import Layout from "../layouts/mainPage.astro";
import TurnOnTimer from "../components/turn-on-timer";
import BimboSettingsEditor from "../components/bimbo-settings-editor";
import type { Config } from "../script/types";

const title = "Bimbo";
const queryParams = Astro.url.searchParams;

if (!queryParams.has("config") || queryParams.get("config") === null) {
  return Astro.redirect("/main");
}

const configID = BigInt(queryParams.get("config")!);

const supabase = createClient(import.meta.env.SUPABASE_URL, import.meta.env.SUPABASE_SERVICE_KEY);

const { data: configData, error: configError } = await supabase.from("Config").select("*").eq("id", configID).maybeSingle();

if (configError) {
  console.error("[supabase] Error fetching bimbo config:", configError);
  return Astro.redirect("/main");
}

if (!configData) {
  return Astro.redirect("/main");
}
---

<Layout title={title}>
  <TurnOnTimer client:load title={"Bimbo End"} configId={configData.id} endField="bimbo_end" initialEnd={configData.bimbo_end} />
  <BimboSettingsEditor client:load configId={configData.id} initialBimboWordLength={configData.bimbo_word_length ?? 0} />
</Layout>
