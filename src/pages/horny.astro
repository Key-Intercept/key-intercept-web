---
export const prerender = false;

import { createClient } from "@supabase/supabase-js";
import Layout from "../layouts/mainPage.astro";
import TurnOnTimer from "../components/turn-on-timer";

const title = "Horny";
const queryParams = Astro.url.searchParams;

if (!queryParams.has("config") || queryParams.get("config") === null) {
  return Astro.redirect("/main");
}

const configID = BigInt(queryParams.get("config")!);

const supabase = createClient(import.meta.env.SUPABASE_URL, import.meta.env.SUPABASE_SERVICE_KEY);

const { data: configData, error: configError } = await supabase.from("Config").select("*").eq("id", configID).maybeSingle();

if (configError) {
  console.error("[supabase] Error fetching horny config:", configError);
  return Astro.redirect("/main");
}

if (!configData) {
  return Astro.redirect("/main");
}
---

<Layout title={title}>
  <TurnOnTimer client:load title={"Horny End"} configId={configData.id} endField="horny_end" initialEnd={configData.horny_end} />
</Layout>
